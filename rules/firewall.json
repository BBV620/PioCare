  "rules": [
    { "id": "in-smb-public", "display": "Partajare fișiere (SMB) din rețele publice", "direction": "in", "protocol": "TCP", "local_ports": "139,445", "profiles": "Public", "needed_for": [], "risk": "low", "why": "Portul prin care s-au răspândit WannaCry și alți viermi. Într-o rețea străină nu are ce căuta deschis." },
    { "id": "in-smb-private", "display": "Partajare fișiere (SMB) din rețeaua de acasă", "direction": "in", "protocol": "TCP", "local_ports": "139,445", "profiles": "Private", "needed_for": ["partajare_fisiere"], "risk": "medium", "why": "Dacă nu partajezi fișiere cu alte PC-uri, nimeni din rețea nu trebuie să ajungă la discurile tale." },
    { "id": "in-netbios-public", "display": "NetBIOS din rețele publice", "direction": "in", "protocol": "UDP", "local_ports": "137,138", "profiles": "Public", "needed_for": [], "risk": "low", "why": "Anunță numele PC-ului în rețea; folosit pentru recunoaștere de atacatori." },
    { "id": "in-rdp", "display": "Desktop la distanță (RDP)", "direction": "in", "protocol": "TCP", "local_ports": "3389", "profiles": "Any", "needed_for": ["desktop_distanta"], "risk": "medium", "why": "Una dintre cele mai atacate porți de intrare în Windows." },
    { "id": "in-winrm", "display": "Administrare la distanță (WinRM)", "direction": "in", "protocol": "TCP", "local_ports": "5985,5986", "profiles": "Any", "needed_for": [], "risk": "low", "why": "Control al PC-ului prin PowerShell din rețea; inutil pe un PC personal." },
    { "id": "in-telnet", "display": "Telnet", "direction": "in", "protocol": "TCP", "local_ports": "23", "profiles": "Any", "needed_for": [], "risk": "low", "why": "Protocol vechi, necriptat." },
    { "id": "in-llmnr-public", "display": "LLMNR din rețele publice", "direction": "in", "protocol": "UDP", "local_ports": "5355", "profiles": "Public", "needed_for": [], "risk": "low", "why": "Folosit în atacuri de furt de parole în rețele Wi-Fi publice." },
    { "id": "in-ssdp-public", "display": "UPnP / SSDP din rețele publice", "direction": "in", "protocol": "UDP", "local_ports": "1900", "profiles": "Public", "needed_for": [], "risk": "low", "why": "Descoperire automată de dispozitive; într-o rețea străină doar expune PC-ul." },
    { "id": "in-upnp-public", "display": "UPnP Host din rețele publice", "direction": "in", "protocol": "TCP", "local_ports": "2869", "profiles": "Public", "needed_for": [], "risk": "low", "why": "Găzduire dispozitive UPnP; inutil în rețele străine." },
    { "id": "in-ssdp-private", "display": "UPnP / SSDP din rețeaua de acasă", "direction": "in", "protocol": "UDP", "local_ports": "1900", "profiles": "Private", "needed_for": ["retea_locala"], "risk": "low", "why": "Dacă nu faci streaming spre TV/console, nu e nevoie." },
